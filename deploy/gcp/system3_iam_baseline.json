  "project_bindings": [
    {"member": "serviceAccount:genesis-system3-automation@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/run.admin"},
    {"member": "serviceAccount:genesis-system3-automation@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/cloudbuild.builds.editor"},
    {"member": "serviceAccount:genesis-system3-automation@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/artifactregistry.reader"},
    {"member": "serviceAccount:genesis-system3-automation@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/cloudscheduler.admin"},
    {"member": "serviceAccount:genesis-system3-automation@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/serviceusage.serviceUsageConsumer"},
    {"member": "serviceAccount:genesis-system3-automation@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/browser"},
    {"member": "serviceAccount:genesis-system3-web@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/datastore.user"},
    {"member": "serviceAccount:gs3-scheduler-collector@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/datastore.user"},
    {"member": "serviceAccount:gs3-scheduler-collector@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/run.viewer"},
    {"member": "serviceAccount:gs3-scheduler-collector@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/cloudscheduler.viewer"},
    {"member": "serviceAccount:gs3-rank-job@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/datastore.user"},
    {"member": "serviceAccount:gs3-forecast-job@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/datastore.user"},
    {"member": "serviceAccount:gs3-signals-job@system3-openalgo-safe.iam.gserviceaccount.com", "role": "roles/datastore.user"}
  ],
  "dhan_job": {
    "name": "genesis-system3-dhan-token-rotate",
    "required_invokers": [
      "serviceAccount:gs3-scheduler@system3-openalgo-safe.iam.gserviceaccount.com",
      "serviceAccount:gs3-token-recovery@system3-openalgo-safe.iam.gserviceaccount.com"
