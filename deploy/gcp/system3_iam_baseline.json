    "forbidden_invokers": [
      "serviceAccount:genesis-system3-web@system3-openalgo-safe.iam.gserviceaccount.com",
      "serviceAccount:802404398783-compute@developer.gserviceaccount.com"
    ]
  },
  "repair": {
    "service_account": "gs3-iam-repair@system3-openalgo-safe.iam.gserviceaccount.com",
    "custom_role_id": "GenesisSystem3IamRepair",
    "workflow_ref": "psw2025-cmd/Genesis_System3/.github/workflows/gcp-authority-repair.yml@refs/heads/main",
    "allowed_actions": ["restore_declared_project_bindings", "restore_declared_service_account_bindings", "restore_declared_secret_iam", "restore_dhan_job_invokers", "remove_known_forbidden_dhan_job_invokers"],
