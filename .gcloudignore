# Genesis System3 Cloud Build source upload exclusions.
# No local secrets, broker files or credentials can enter Cloud Build source.
.gcloudignore
.git/
.git/**
.venv/
**/.venv/
venv/
**/venv/
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
.env
.env.*
**/.env
**/.env.*
.secrets/
.secrets/**
**/.secrets/
**/.secrets/**
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
.pytest_tmp/
**/.pytest_tmp/
.pytest_cache/
**/.pytest_cache/
temp/
scratch/
scratch/**
**/temp/
scratch/
scratch/**
*.log
**/*.log
reports/history/
reports/coordination/
reports/audit/
!reports/latest/
!reports/latest/**
!security_id_list.csv
!state/
!state/**
!state/chains/
!state/chains/**
!state/chain_cache/
!state/chain_cache/**
.agy-proof/
**/.agy-proof/
dashboard/frontend/node_modules/
dashboard/frontend/.vite/

 
forensic_bundle.txt
audit/
storage/
agent_deep_audit/
content/
master_config_audit_report.txt
security_id_list.csv

